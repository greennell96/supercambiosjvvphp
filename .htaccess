# Allow access to PHP files
<FilesMatch "\.php$">
    Allow from all
</FilesMatch>

# Force UTF-8
AddDefaultCharset UTF-8

# Allow SweetAlert2 and CDN scripts (Hostinger blocks eval by default)
<IfModule mod_headers.c>
    Header set Content-Security-Policy "script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.ckeditor.com https://cdn.rawgit.com https://cdn.jsdelivr.net https://fonts.googleapis.com https://cdnjs.cloudflare.com;"
</IfModule>

# ══ MAINTENANCE MODE — delete this block to restore the site ══
# All public traffic gets mantenimiento.php (which sends HTTP 503).
# Exempt: the maintenance page itself, the admin panel (supertasa.php + ajax.php,
# both behind session auth) and the js/ + images/ assets the panel needs.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/mantenimiento\.php$
    RewriteCond %{REQUEST_URI} !^/(supertasa|ajax)\.php$
    RewriteCond %{REQUEST_URI} !^/js/
    RewriteCond %{REQUEST_URI} !^/images/
    RewriteRule ^ /mantenimiento.php [L]
</IfModule>
# ══ END MAINTENANCE MODE ══

# Clean URL: /formularioaml -> formularioaml.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^formularioaml/?$ formularioaml.php [L,QSA]
</IfModule>
