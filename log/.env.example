# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string (Neon / Supabase / local docker, anything).
DATABASE_URL=postgres://user:password@host:5432/dbname

# The single shared desk password. Anything non-empty works.
DESK_PASSWORD=change-me

# Secret used to sign the session cookie. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
